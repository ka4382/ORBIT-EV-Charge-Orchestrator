# Copy to .env. Never commit .env. All services read config from the environment (12-factor).
ORBIT_ENV=dev
KAFKA_BOOTSTRAP=redpanda:9092
MQTT_URL=mqtt://emqx:1883
DATABASE_URL=postgresql://postgres:postgres@timescale:5432/orbit
DATABASE_APP_URL=postgresql://orbit_app:orbit_app@timescale:5432/orbit
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=orbit
S3_SECRET_KEY=orbit-secret
S3_BUCKET=orbit-telemetry
# Auth: dev issuer signs HS256 tokens; prod uses OIDC (Keycloak) RS256 via JWKS_URL
JWT_DEV_SECRET=change-me-dev-only
JWKS_URL=
JWT_ISSUER=orbit-dev
# Simulator
SIM_VEHICLES=100000
SIM_RATE_HZ=1
SIM_TRANSPORT=kafka
SIM_DUP_PCT=0.5
SIM_OOO_PCT=1.0
SIM_TENANTS=8
# Agent
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Archiver: 1 = persist every event to Timescale; 10 = 1-in-10 (laptops). Parquet always gets all events.
ARCHIVER_SAMPLE_DIVISOR=1
# Laptop disk guard (unset in production to use contracts/topics.yaml retention as-is)
KAFKA_RETENTION_MS_MAX=1800000
KAFKA_RETENTION_BYTES_PER_PARTITION=52428800
# Archiver Parquet sampling: 1 = lake keeps every event (production); raise only on a small disk
ARCHIVER_PARQUET_SAMPLE_DIVISOR=1
# Redpanda resources. 3 cores / 3G suits 16 GB machines; use 2 / 1500M when Docker has 8 GB or less.
REDPANDA_SMP=3
REDPANDA_MEMORY=3G
