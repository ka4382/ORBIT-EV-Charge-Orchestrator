{
 "uid": "orbit-ingest",
 "title": "ORBIT \u00b7 Ingest & Stream",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Events in / s by service",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(orbit_events_in_total[30s]))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Events out / s by topic",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (topic) (rate(orbit_events_out_total[30s]))",
     "legendFormat": "{{topic}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Dropped / s by reason",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(orbit_events_dropped_total[30s]))",
     "legendFormat": "{{reason}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Consumer lag",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (orbit_consumer_lag)",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "E2E latency p50 / p95 / p99 (vehicle ts \u2192 processed)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, service) (rate(orbit_e2e_seconds_bucket[1m])))",
     "legendFormat": "p50 {{service}}"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(orbit_e2e_seconds_bucket[1m])))",
     "legendFormat": "p95 {{service}}"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le, service) (rate(orbit_e2e_seconds_bucket[1m])))",
     "legendFormat": "p99 {{service}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Simulator sent / s and errors",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(sim_events_sent_total[30s])",
     "legendFormat": "sent"
    },
    {
     "refId": "B",
     "expr": "rate(sim_send_errors_total[30s])",
     "legendFormat": "errors"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Redpanda: produced bytes / s",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(redpanda_kafka_request_bytes_total{redpanda_request=\"produce\"}[30s]))",
     "legendFormat": "produce"
    }
   ]
  },
  {
   "id": 8,
   "type": "bargauge",
   "title": "Top DTC codes (Count-Min sketch)",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, orbit_dtc_topk)",
     "legendFormat": "{{code}}"
    }
   ]
  }
 ]
}